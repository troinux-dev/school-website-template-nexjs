# ---- Database (Supabase → Project settings → Database → Connection string) ----
# Transaction pooler (port 6543) for the app:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct/session connection (port 5432) for migrations (optional; falls back to DATABASE_URL):
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://www.your-school.co.za

# ---- Microsoft Entra ID (App registrations → your app) ----
AUTH_MICROSOFT_ENTRA_ID_ID=<application-client-id>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<client-secret-value>
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---- First-run onboarding ----
# Anyone opening /onboarding must enter this code before the site is set up.
SETUP_TOKEN=

# ---- File uploads (optional) ----
# With these set, photos/PDFs go to Supabase Storage (create a PUBLIC bucket with this name).
# Without them, files are saved to /app/uploads — keep that as a Docker volume.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-assets

# ---- Misc ----
SCHOOL_TIMEZONE=Africa/Johannesburg

# ---- Local development only — never enable in production ----
# AUTH_DEV_LOGIN=true
# AUTH_DEV_PASSWORD=choose-something
